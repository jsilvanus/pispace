# Copy to ~/apps/pispace/.env (never commit the real file).
PISPACE_PORT=3203
PISPACE_HOST=0.0.0.0
PISPACE_GATEWAY_URL=http://127.0.0.1:3000
# Site venue and meshes live in the private site repo (e.g. keskuskirkko/apps/pispace), not here.
PISPACE_VENUE_FILE=/home/pi/apps/keskuskirkko/apps/pispace/keskuskirkko-venue.json
PISPACE_MODELS_DIR=/home/pi/apps/keskuskirkko/apps/pispace/models
# Bearer key for PUT /api/v1/venue, layout switching and placement moves. Unset = read-only.
PISPACE_EDIT_KEY=
# PISPACE_API_KEY=
# PISPACE_CORS_ORIGINS=http://keskuskirkko.local:8080
