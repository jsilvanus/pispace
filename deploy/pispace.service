[Unit]
Description=PiSpace 3D Venue Digital Twin
After=network-online.target pigateway.service

[Service]
WorkingDirectory=%h/apps/pispace
EnvironmentFile=%h/apps/pispace.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/node dist/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
