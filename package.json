{
  "name": "pispace",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "description": "Spatial engine for the Pi ecosystem: FreeD camera raycasting, 3D venue mapping, and zone verification",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pispace": "bin/pispace.mjs"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "bin",
    "web"
  ],
  "pi": {
    "service": "pispace",
    "layer": "Layer 2: Media pipeline",
    "displayName": "pispace",
    "port": 3203,
    "healthEndpoint": "/health",
    "envPortVar": "PISPACE_PORT"
  }
}
